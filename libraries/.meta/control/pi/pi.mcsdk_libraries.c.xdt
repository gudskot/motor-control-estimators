% var moduleName = "pi"
% var libraryFolder = "control"
% var module = system.modules['/libraries/' + libraryFolder + '/' + moduleName + '.js'];
%if (module != null)
%{
    % for(var i = 0; i < module.$instances.length; i++) {
        % var instance = module.$instances[i];
    % }

    % var initFunctions = [];
    % for(var i = 0; i < module.$instances.length; i++) {
        % var instance = module.$instances[i];
        % let modInst  = instance[moduleName];
        % if (instance.$ownedBy == null) {

PI_Obj `instance.$name`_obj;
PI_Handle `instance.$name`_handle = &`instance.$name`_obj;

void `instance.$name`_init(){
    PI_setGains(`instance.$name`_handle, `instance.$name`_KP, `instance.$name`_KI);
    PI_setUi(`instance.$name`_handle, `instance.$name`_UI);
    PI_setRefValue(`instance.$name`_handle, `instance.$name`_REFVAL);
    PI_setFbackValue(`instance.$name`_handle, `instance.$name`_FBVAL);
    PI_setFfwdValue(`instance.$name`_handle, `instance.$name`_FFVAL);
    PI_setMinMax(`instance.$name`_handle, `instance.$name`_OUTMIN, `instance.$name`_OUTMAX);
}       
            % initFunctions.push(instance.$name+ "_init");
        % }
    % }

void `module.mcsdkLibraryName`_all_init() {
    
    //
    // Initialize the instances
    //
    % for (var initFunc of initFunctions) {
    `initFunc`();
    % }
}
%}
%