% var moduleName = "pi"
% var libraryFolder = "control"
% var module = system.modules['/libraries/' + libraryFolder + '/' + moduleName + '.js'];
%
%if (module != null)
%{
#include <`moduleName`.h>
    % if (module.$instances)
    % {
#define `module.mcsdkLibraryName`_COUNT `module.$instances.length`

        % for(var i = 0; i < module.$instances.length; i++)
        % {
            % var instance = module.$instances[i];
            % if(instance.$ownedBy == null)
            %{
#define `instance.$name`_KP `instance.kpVal`
#define `instance.$name`_KI `instance.kiVal`
#define `instance.$name`_UI `instance.uiVal`
#define `instance.$name`_REFVAL `instance.refVal`
#define `instance.$name`_FBVAL `instance.feedbackVal`
#define `instance.$name`_FFVAL `instance.feedforwardVal`
#define `instance.$name`_OUTMIN `instance.outMinVal`
#define `instance.$name`_OUTMAX `instance.outMaxVal`
            %}

        % }
        % for(var i = 0; i < module.$instances.length; i++)
        % {
            % var instance = module.$instances[i];
            % let modInst  = instance[moduleName];
            % if (instance.$ownedBy == null)
            % {
extern PI_Handle `instance.$name`_handle;
            % }
        % }

        % for(var i = 0; i < module.$instances.length; i++)
        % {
            % var instance = module.$instances[i];
            % let modInst  = instance[moduleName];
            % if (instance.$ownedBy == null)
            % {
void `instance.$name`_init();
            % }
        % }
    % }
% }