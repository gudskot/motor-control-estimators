% var moduleName = "offset"
% var libraryFolder = "filter"
% var module = system.modules['/libraries/' + libraryFolder + '/' + moduleName + '.js'];
%
%if (module != null)
%{
    % for(var i = 0; i < module.$instances.length; i++) {
        % var instance = module.$instances[i];
    % }
    % var initFunctions = [];
    % for(var i = 0; i < module.$instances.length; i++) {
        % var instance = module.$instances[i];
        % let modInst  = instance[moduleName];
        % if (instance.$ownedBy == null) {
OFFSET_Obj `instance.$name`_obj;
OFFSET_Handle `instance.$name`_handle = &`instance.$name`_obj;

void `instance.$name`_init(){
    `instance.$name`_handle->filter = *filter_fo_`instance.FILTER_FO.$name`_Handle;
    `instance.$name`_handle->filterHandle = filter_fo_`instance.FILTER_FO.$name`_Handle;

    OFFSET_setOffset(`instance.$name`_handle, `instance.$name`_OFFSET_VAL);
    %if(instance.enableSetBeta == true)
    %{
    OFFSET_setBeta(`instance.$name`_handle, `instance.$name`_BETA_RAD);
    %}
    %if(instance.enableSetInitCond == true)
    %{
    OFFSET_setInitCond(`instance.$name`_handle, `instance.$name`_INIT_COND);
    %}
}       
            % initFunctions.push(instance.$name+ "_init");
        % }
    % }

void `module.mcsdkLibraryName`_all_init() {
    //
    // Initialize the instances
    //
    % for (var initFunc of initFunctions) {
    `initFunc`();
    % }
}
%}