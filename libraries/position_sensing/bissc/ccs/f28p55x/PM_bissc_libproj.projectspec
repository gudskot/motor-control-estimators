<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
  <project
        name="PM_bissc_f28p55x_lib"
        device="TMS320F28P550SJ9"
        cgtVersion="22.6.2.LTS"
        launchWizard="False"
        outputType="staticLibrary"
        outputFormat="ELF"
        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --product ${C2000WARE_ROOT}/.metadata/sdk.json
            --device F28P55x
            --package 100PZ
            --part F28P55x_100PZ
        "
        compilerBuildOptions=" 
            -v28
            --abi=eabi
            --unified_memory
            --float_support=fpu32
            --fp_mode=relaxed
            --tmu_support=tmu0
            --cla_support=cla2
            --define=CPU1
            --define=_LAUNCHXL_F28P55X
            --define=_F28P55X           
            --diag_warning=225
            --diag_suppress=10063
            --display_error_number
            -I${C2000WARE_DLIB_ROOT}  
            -I${PROJECT_ROOT}/device
            -I${PROJECT_ROOT}/include            
            -I${CCS_PROJECT_DIR}/../PM_bissc_f28p55x_lib/include
        "   
        postBuildStep="
             if ${GENERATE_DIAGRAM} == 1  echo ========= Build of the CLB simulation has moved to the CLB Tool. Click the '?' icon by the _Generate CLB Simulation File_ enable for more details (located in the Global Parameters of the Tile Design SysConfig module) =============
            ;if ${GENERATE_DIAGRAM} == 1  mkdir &quot;${BuildDirectory}/diagrams&quot;
            ;if ${GENERATE_DIAGRAM} == 1  ${NODE_TOOL} &quot;${C2000WARE_ROOT}/driverlib/.meta/generate_diagrams.js&quot; &quot;${C2000WARE_ROOT}&quot; &quot;${BuildDirectory}/diagrams&quot; &quot;${BuildDirectory}/syscfg&quot;
            ;if ${GENERATE_DIAGRAM} == 1  ${NODE_TOOL} &quot;${C2000WARE_ROOT}/utilities/clb_tool/clb_syscfg/dot_file_libraries/clbDotUtility.js&quot;  &quot;${C2000WARE_ROOT}/utilities/clb_tool/clb_syscfg/&quot; &quot;${BuildDirectory}/syscfg&quot; &quot;${BuildDirectory}/syscfg/clb.dot&quot;
        "
      >
      <configuration 
          name="RELEASE"    
          compilerBuildOptions="
              --opt_level=4
              --opt_for_speed=5
          "
          archiverBuildOptions="${PROJECT_ROOT}/lib/PM_bissc_f28p55x.lib"
      />
    <!-- Set to 0 to skip post-build of Sysconfig diagrams -->
    <buildVariable name="GENERATE_DIAGRAM" value="1" scope="project" />

    <!-- Device specific path names -->
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../../../c2000ware/driverlib/f28p55x/driverlib" scope="project" />
    <pathVariable name="C2000WARE_DEVICE_SUPPORT_ROOT" path="../../../../../c2000ware/device_support/f28p55x" scope="project" />
    
    <!-- Standard support path names -->
    <pathVariable name="SOLUTION_LIB_ROOT" path="../.." scope="project" />
    <pathVariable name="C2000WARE_ROOT" path="../../../../../c2000ware" scope="project" />

    <!-- Standard support files -->
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/include/driverlib.h" targetDirectory="device" />

    <!-- Solution-specific files -->
    <file action="copy" path="SOLUTION_LIB_ROOT/lib/PM_bissc_f28p55x.lib" targetDirectory="lib" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_bissc_source.c" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_bissc_crc.c" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_bissc_f28p55x.syscfg" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/include/pm_bissc_include.h" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/include/pm_bissc_internal_include.h" targetDirectory="source" />
    
    <!-- This is an empty device.h file to satisfy clb_config.c #includes.                             -->
    <!-- It is placed in the /device targetDirectory so that the comms demo project will not locate it -->
    <file action="copy" path="SOLUTION_LIB_ROOT/include/device.h" targetDirectory="device" />
  </project>
</projectSpec>
