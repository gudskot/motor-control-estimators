TILE2.BOUNDARY.in_custom_source1   = "#define RESET 40\n#define HALF_WIDTH 10\n#define WIDTH 20\n#define WAIT_FOR_START_OP 40\n#define WAIT_FOR_END_OP 40\n#define DELAY_MESSAGE1 60\n#define WAIT_FOR_TIMEOUT1 200\n#define DELAY_MESSAGE2 75\n#define DELAY_ACK2 80\n#define WAIT_FOR_TIMEOUT2 80\n#define DELAY_MESSAGE3 97\n#define DELAY_ACK3 120\n#define WAIT_FOR_TIMEOUT3 200\n#define HEADER 20\n#define DATA 20\nhigh(RESET)\nhigh(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE1)\nlow(HEADER)\nhigh(HEADER)\nlow(HEADER)\nlow(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nlow(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(WAIT_FOR_TIMEOUT1)\nhigh(WAIT_FOR_END_OP)\nhigh(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE2)\nlow(HEADER)\nlow(DELAY_ACK2)\nhigh(HEADER)\nlow(HEADER)\nlow(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nlow(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(WAIT_FOR_TIMEOUT2)\nhigh(WAIT_FOR_END_OP)\nhigh(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE3)\nlow(HEADER)\nlow(DELAY_ACK3)\nhigh(HEADER)\nlow(HEADER)\nlow(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nlow(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nlow(WAIT_FOR_TIMEOUT3)\nhigh(1)";
TILE2.BOUNDARY.in_custom_source7   = "#define RESET 40\n#define HALF_WIDTH 10\n#define WIDTH 20\n#define WAIT_FOR_START_OP 40\n#define WAIT_FOR_END_OP 40\n#define DELAY_MESSAGE1 60\n#define WAIT_FOR_TIMEOUT1 200\n#define DELAY_MESSAGE2 75\n#define DELAY_ACK2 80\n#define WAIT_FOR_TIMEOUT2 80\n#define DELAY_MESSAGE3 97\n#define DELAY_ACK3 120\n#define WAIT_FOR_TIMEOUT3 200\n#define HEADER 20\n#define DATA 20\nhigh(RESET)\nhigh(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE1)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(WAIT_FOR_TIMEOUT1)\nhigh(WAIT_FOR_END_OP)\nhigh(WAIT_FOR_START_OP)\nlow(DELAY_MESSAGE2)\nlow(HEADER)\nlow(DELAY_ACK2)\nlow(HEADER)\nlow(HEADER)\nlow(HEADER)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(5)\nlow(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(3)\nlow(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nlow(WAIT_FOR_TIMEOUT2)\nlow(WAIT_FOR_END_OP)\nlow(WAIT_FOR_START_OP)\nlow(DELAY_MESSAGE2)\nlow(HEADER)\nlow(DELAY_ACK3)\nlow(HEADER)\nlow(HEADER)\nlow(HEADER)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(5)\nlow(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nrpt(3)\nlow(DATA)\nrpt_end\nlow(DATA)\nrpt(3)\nlow(DATA)\nrpt_end\nlow(WAIT_FOR_TIMEOUT3)\nlow(1)";
TILE2.BOUNDARY.in_custom_source0   = "#define RESET 40\n#define HALF_WIDTH 10\n#define WIDTH 20\n#define WAIT_FOR_START_OP 40\n#define WAIT_FOR_END_OP 40\n#define DELAY_MESSAGE1 60\n#define WAIT_FOR_TIMEOUT1 200\n#define DELAY_MESSAGE2 75\n#define DELAY_ACK2 80\n#define WAIT_FOR_TIMEOUT2 80\n#define DELAY_MESSAGE3 97\n#define DELAY_ACK3 120\n#define WAIT_FOR_TIMEOUT3 200\n#define HEADER 20\n#define DATA 20\nlow(RESET)\nlow(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE1)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(WAIT_FOR_TIMEOUT1)\nlow(WAIT_FOR_END_OP)\nlow(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE2)\nhigh(HEADER)\nhigh(DELAY_ACK2)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(WAIT_FOR_TIMEOUT2)\nlow(WAIT_FOR_END_OP)\nlow(WAIT_FOR_START_OP)\nhigh(DELAY_MESSAGE3)\nhigh(HEADER)\nhigh(DELAY_ACK3)\nhigh(HEADER)\nhigh(HEADER)\nhigh(HEADER)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(5)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(DATA)\nrpt(3)\nhigh(DATA)\nrpt_end\nhigh(WAIT_FOR_TIMEOUT3)\nlow(1)";
