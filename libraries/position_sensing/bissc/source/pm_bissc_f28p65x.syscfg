TILE2.LUT_0.$name                  = "LUT_0";
TILE2.LUT_0.i0                     = "COUNTER_1.count_match1";
TILE2.LUT_0.i2                     = "BOUNDARY.in0";
TILE2.LUT_0.i3                     = "BOUNDARY.in3";
TILE2.LUT_0.eqn                    = "(i0  & i3) | i2";
TILE2.LUT_0.lutDescription         = "out: high for 1 clb clock in the following conditions\na) START_OPERATION_RE\nb) RECEIVE_DATA_COMPLETE. This is aligned to the rising edge of the ENCODER_CLOCK \n";
TILE2.LUT_1.$name                  = "LUT_1";
TILE2.LUT_1.i0                     = "BOUNDARY.in3";
TILE2.LUT_1.i1                     = "FSM_1.S0";
TILE2.LUT_1.i2                     = "FSM_1.S1";
TILE2.LUT_1.lutDescription         = "Qualification for the ENCODER_CLOCK_RE. \nOnly pass on the ENCODER_CLOCK_RE if \n(1) FRAME_STATE == TRANSMIT (state 01) or \n(2) FRAME_STATE == TRANSMIT_AND_RECEIVE (state 10)";
TILE2.LUT_1.eqn                    = "i0 & (!i2 & i1 | i2 & !i1)";
TILE2.LUT_2.$name                  = "LUT_2";
TILE2.LUT_2.eqn                    = "i0 & (i1 & (~i2))";
TILE2.LUT_2.i1                     = "FSM_1.S0";
TILE2.LUT_2.i2                     = "FSM_1.S1";
TILE2.LUT_2.i0                     = "BOUNDARY.in1";
TILE2.LUT_2.lutDescription         = "Detect the ACK from the encoder. \nIf the FRAME_STATE is WAIT_FOR_ACK (0,1) and ENCODER_RESPONSE_RE goes high, then ACK has been detected.\nout: will transition from low to high for one CLB clock when ACK is detected";
TILE2.FSM_0.$name                  = "FSM_0";
TILE2.FSM_0.xe0                    = "BOUNDARY.in2";
TILE2.FSM_0.xe1                    = "BOUNDARY.in7";
TILE2.FSM_0.e0                     = "FSM_1.S0";
TILE2.FSM_0.e1                     = "FSM_1.S1";
TILE2.FSM_0.eqn_out                = "~(( (~xe0) & (e0 ^ e1)) | ((~xe1) & (e0 & e1)))";
TILE2.FSM_0.fsmDescription         = "Append the CDM bit to the end of the MA signal";
TILE2.FSM_1.$name                  = "FSM_1";
TILE2.FSM_1.e0                     = "LUT_0.OUT";
TILE2.FSM_1.eqn_out                = "(!s0 & !s1)";
TILE2.FSM_1.e1                     = "BOUNDARY.in1";
TILE2.FSM_1.eqn_s0                 = "(!s1 & !s0 & e0) | (!s1 & s0 & !e1) | (s1 & !s0 & e0) | (s1 & s0)";
TILE2.FSM_1.eqn_s1                 = "(!s1 & s0 & e1) | (s1 & !s0) | (s1 & s0)";
TILE2.FSM_1.fsmDescription         = "Frame state generation\ne0: START_OPERATION_RE or ENCODER_CLOCK_COMPLETE\ne1: RESPONSE_RE\ns0,s1: FRAME_STATE\nout: IDLE";
TILE2.FSM_2.$name                  = "FSM_2";
TILE2.FSM_2.eqn_s0                 = "(((~s0)&(~s1)) & e1) | ((s0&(~s1)) & (~e0))";
TILE2.FSM_2.eqn_out                = "xe1 & s0";
TILE2.FSM_2.e0                     = "COUNTER_2.count_match1";
TILE2.FSM_2.e1                     = "FSM_1.S1";
TILE2.FSM_2.xe1                    = "BOUNDARY.in5";
TILE2.FSM_2.eqn_s1                 = "(~s1 & e0) | (s1 & e0 & e1) | (s1 & s0)";
TILE2.FSM_2.fsmDescription         = "CLB_SPI_CLOCK output enable and count enable";
TILE2.COUNTER_0.$name              = "COUNTER_0";
TILE2.COUNTER_1.$name              = "COUNTER_1";
TILE2.COUNTER_1.event_load_val     = "10";
TILE2.COUNTER_1.mode1              = "1";
TILE2.COUNTER_1.mode0              = "LUT_1.OUT";
TILE2.COUNTER_1.match1_val         = "200";
TILE2.COUNTER_1.reset              = "FSM_1.OUT";
TILE2.COUNTER_1.counterDescription = "Count the number of CLB_ENCODER_CLOCKS output ";
TILE2.COUNTER_2.$name              = "COUNTER_2";
TILE2.COUNTER_2.mode0              = "FSM_2.OUT";
TILE2.COUNTER_2.mode1              = "1";
TILE2.COUNTER_2.match1_val         = "24";
TILE2.COUNTER_2.reset              = "FSM_1.OUT";
TILE2.COUNTER_2.counterDescription = "Count the number of CLB_SPI_CLOCKs sent\n";
TILE2.OUTLUT_0.$name               = "OUTLUT_0";
TILE2.OUTLUT_0.eqn                 = "(~( (~i0) & (i1))) ";
TILE2.OUTLUT_0.i0                  = "BOUNDARY.in4";
TILE2.OUTLUT_0.i1                  = "FSM_2.S0";
TILE2.OUTLUT_0.outlutDescription   = "CLB_SPI_CLOCK";
TILE2.OUTLUT_1.$name               = "OUTLUT_1";
TILE2.OUTLUT_1.eqn                 = "i0";
