<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
  <project
        name="PM_tformat_f28002x_lib"
        title="T-Format Encoder Interface Example Library"        
        device="TMS320F280025C"
        outputType="staticLibrary"         
        cgtVersion="22.6.0.LTS"
        outputFormat="ELF"        
        launchWizard="False"
        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --product ${C2000WARE_ROOT}/.metadata/sdk.json
            --device F28002x
            --package 80QFP
            --part F28002x_80QFP
        "
        compilerBuildOptions="         
            -v28
            --abi=eabi
            --unified_memory
            --float_support=fpu32
            --float_operations_allowed=32
            --fp_mode=relaxed
            --tmu_support=tmu1
            --vcu_support=vcrc
            --define=CPU1
            --define=_LAUNCHXL_F280025C
            --define=_F28002X 
            --diag_warning=225
            --diag_suppress=10063
            --display_error_number
            -I${C2000WARE_DLIB_ROOT}
            -I${PROJECT_ROOT}/include
            -I${PROJECT_ROOT}/device
            -I${CCS_WORKSPACE_DIR}/PM_tformat_f28002x_lib/include
        "        
        postBuildStep="
             if ${GENERATE_DIAGRAM} == 1  echo ========= Build of the CLB simulation has moved to the CLB Tool. Click the '?' icon by the _Generate CLB Simulation File_ enable for more details (located in the Global Parameters of the Tile Design SysConfig module) =============
            ;if ${GENERATE_DIAGRAM} == 1  mkdir &quot;${BuildDirectory}/diagrams&quot;
            ;if ${GENERATE_DIAGRAM} == 1  ${NODE_TOOL} &quot;${C2000WARE_ROOT}/driverlib/.meta/generate_diagrams.js&quot; &quot;${C2000WARE_ROOT}&quot; &quot;${BuildDirectory}/diagrams&quot; &quot;${BuildDirectory}/syscfg&quot;
            ;if ${GENERATE_DIAGRAM} == 1  ${NODE_TOOL} &quot;${C2000WARE_ROOT}/utilities/clb_tool/clb_syscfg/dot_file_libraries/clbDotUtility.js&quot;  &quot;${C2000WARE_ROOT}/utilities/clb_tool/clb_syscfg/&quot; &quot;${BuildDirectory}/syscfg&quot; &quot;${BuildDirectory}/syscfg/clb.dot&quot;
            "
        >
      <configuration 
          name="RELEASE"    
          compilerBuildOptions="
              --opt_level=4
              --opt_for_speed=5
          "
          archiverBuildOptions="${PROJECT_ROOT}/lib/PM_tformat_lib_f28002x.lib"
      />
    <!-- Set to 0 to skip post-build of Sysconfig diagrams -->
    <buildVariable name="GENERATE_DIAGRAM" value="1" scope="project" />

    <!-- Device specific path names -->
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../../../c2000ware/driverlib/f28002x/driverlib" scope="project" />
    <pathVariable name="C2000WARE_DEVICE_SUPPORT_ROOT" path="../../../../../c2000ware/device_support/f28002x" scope="project" />
    
    <!-- Standard support path names -->
    <pathVariable name="SOLUTION_LIB_ROOT" path="../.." scope="project" />
    <pathVariable name="C2000WARE_ROOT" path="../../../../../c2000ware" scope="project" />

    <!-- Standard support files -->
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/include/driverlib.h" targetDirectory="device" />
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/include/device.h" targetDirectory="device" />

    <!-- Solution-specific files -->
    <!-- ## LinkorCopy: For internal development these can be changed to link -->
    <file action="copy" path="SOLUTION_LIB_ROOT/lib/PM_tformat_lib_f28002x.lib" targetDirectory="lib" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_tformat_source.c" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_tformat_crc_vcrc.asm" targetDirectory="source" />    
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_tformat_crc.c" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/source/pm_tformat_f28002x.syscfg" targetDirectory="source" />
    <file action="copy" path="SOLUTION_LIB_ROOT/include/PM_tformat_include.h" targetDirectory="include" />
    <file action="copy" path="SOLUTION_LIB_ROOT/include/PM_tformat_internal_include.h" targetDirectory="include" />
    <file action="copy" path="SOLUTION_LIB_ROOT/include/PM_tformat_deprecated.h" targetDirectory="include" />
  </project>
</projectSpec>
