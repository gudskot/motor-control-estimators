TILE2.BOUNDARY.in_edge4            = "falling edge";
TILE2.BOUNDARY.tileOutputSelect4   = 7;
TILE2.LUT_0.lutDescription         = "Field count control\n- i0, i1 FRAME_STATE";
TILE2.LUT_2.lutDescription         = "Clock qualification\nmasks the clock rising edge except\nwhen COUNT_BITSs is active (low)\n- i0 COUNT_BITSn\n- i1 CLOCK_RISING_EDGE\n- out INCREMENT_BIT_COUNT";
TILE2.LUT_1.lutDescription         = "CRC shift control\nShifts the CRC generation counter\nwhen the data is part of the CRC\ncalculation.\n- i0 CLOCK_RISING_EDGE\n- i1 DATA_VALID\n- i2 RECEIVE_DATAn\n- i3 CRC_DATA_FIELD\n- out SHIFT_ENABLE (1 CLB CLK)";
TILE2.FSM_0.fsmDescription         = "Field data mask\nMasks the start and delimiter bits \nin each response field.\n- e0 DATA_START\n- e1 DATA_END\n- s0 DATA_VALID";
TILE2.FSM_1.fsmDescription         = "Data-bit count control\nEnable data-bit count when receiving\nbits used to calculate the CRC\n- e0 ENCODER_RESPONSE falling edge\n- e1 DATA_END";
TILE2.COUNTER_0.counterDescription = "Bit count\nMark the start and end of the\n8-bit data in each field.\nExclude the start and delimiter\n- reset COUNT_BITSn\n- event INCREMENT_BIT_COUNT\n- match1 DATA_START\n- match2 DATA_END";
TILE2.COUNTER_1.counterDescription = "Field count\nIncrements at the start of \neach field.\n- reset RECEIVE_DATAn\n- event DATA_START\n- match1 marks the start of the \n  CRC field";
TILE2.COUNTER_2.counterDescription = "CRC generator\nConfigured as a serializer\nin LFSR mode\n- event ENCODER_RESPONSE\n- mode0 SHIFT_ENABLE one clb clk wide";
TILE2.LUT_0.$name                  = "LUT_3";
TILE2.LUT_0.i1                     = "BOUNDARY.in1";
TILE2.LUT_0.eqn                    = "! (i0 & i1)";
TILE2.LUT_0.i0                     = "BOUNDARY.in0";
TILE2.LUT_0.lutDescription         = "Field count control\n- i0, i1 FRAME_STATE";
TILE2.LUT_1.$name                  = "LUT_4";
TILE2.LUT_1.i0                     = "BOUNDARY.in3";
TILE2.LUT_1.i1                     = "FSM_0.S0";
TILE2.LUT_1.i3                     = "COUNTER_1.count_match1";
TILE2.LUT_1.i2                     = "COUNTER_1.count_zero";
TILE2.LUT_1.eqn                    = "(i0 & i1) & (!i2 & !i3)";
TILE2.LUT_1.lutDescription         = "CRC shift control\nShifts the CRC generation counter\nwhen the data is part of the CRC\ncalculation.\n- i0 CLOCK_RISING_EDGE\n- i1 DATA_VALID\n- i2 RECEIVE_DATAn\n- i3 CRC_DATA_FIELD\n- out SHIFT_ENABLE (1 CLB CLK)";
TILE2.LUT_2.$name                  = "LUT_5";
TILE2.LUT_2.i1                     = "BOUNDARY.in3";
TILE2.LUT_2.eqn                    = "(i1 & !i0)";
TILE2.LUT_2.i0                     = "FSM_1.OUT";
TILE2.LUT_2.lutDescription         = "Clock qualification\nmasks the clock rising edge except\nwhen COUNT_BITSs is active (low)\n- i0 COUNT_BITSn\n- i1 CLOCK_RISING_EDGE\n- out INCREMENT_BIT_COUNT";
TILE2.FSM_0.$name                  = "FSM_3";
TILE2.FSM_0.eqn_s0                 = "(e0&s0) | ((!e0)&(!e1)&s0) | (e0&(!e1)&(!s0))";
TILE2.FSM_0.e0                     = "COUNTER_0.count_match1";
TILE2.FSM_0.e1                     = "COUNTER_0.count_match2";
TILE2.FSM_0.fsmDescription         = "Field data mask\nMasks the start and delimiter bits \nin each response field.\n- e0 DATA_START\n- e1 DATA_END\n- s0 DATA_VALID";
TILE2.FSM_1.$name                  = "FSM_4";
TILE2.FSM_1.e1                     = "COUNTER_0.count_match2";
TILE2.FSM_1.e0                     = "BOUNDARY.in4";
TILE2.FSM_1.eqn_out                = "s0";
TILE2.FSM_1.eqn_s0                 = "(s0 & s1) | e1 | (!e1 & e0 & !s1 & s0)";
TILE2.FSM_1.eqn_s1                 = "(s1 & s0 & !e1 & !e0) | (e1 & !s1 & !s0) | (e1 & s1 & s0)";
TILE2.FSM_1.fsmDescription         = "Data-bit count control\nEnable data-bit count when receiving\nbits used to calculate the CRC\n- e0 ENCODER_RESPONSE falling edge\n- e1 DATA_END";
TILE2.FSM_2.$name                  = "FSM_5";
TILE2.COUNTER_0.$name              = "COUNTER_3";
TILE2.COUNTER_0.mode1              = "1";
TILE2.COUNTER_0.match1_val         = "1";
TILE2.COUNTER_0.match2_val         = "9";
TILE2.COUNTER_0.event              = "LUT_2.OUT";
TILE2.COUNTER_0.action             = "Add";
TILE2.COUNTER_0.event_load_val     = "1";
TILE2.COUNTER_0.reset              = "FSM_1.OUT";
TILE2.COUNTER_0.counterDescription = "Bit count\nMark the start and end of the\n8-bit data in each field.\nExclude the start and delimiter\n- reset COUNT_BITSn\n- event INCREMENT_BIT_COUNT\n- match1 DATA_START\n- match2 DATA_END";
TILE2.COUNTER_1.$name              = "COUNTER_4";
TILE2.COUNTER_1.mode1              = "1";
TILE2.COUNTER_1.action             = "Add";
TILE2.COUNTER_1.event_load_val     = "1";
TILE2.COUNTER_1.event              = "COUNTER_0.count_match1";
TILE2.COUNTER_1.reset              = "LUT_0.OUT";
TILE2.COUNTER_1.match1_val         = "4";
TILE2.COUNTER_1.counterDescription = "Field count\nIncrements at the start of \neach field.\n- reset RECEIVE_DATAn\n- event DATA_START\n- match1 marks the start of the \n  CRC field";
TILE2.COUNTER_2.$name              = "COUNTER_5";
TILE2.COUNTER_2.mode0              = "LUT_1.OUT";
