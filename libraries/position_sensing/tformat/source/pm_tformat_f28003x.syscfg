TILE1.AOC_4.$name                      = "AOC_4";
TILE1.AOC_5.$name                      = "AOC_5";
TILE1.AOC_6.$name                      = "AOC_6";
TILE1.AOC_7.$name                      = "AOC_7";

clb2.tile                          = TILE2;
TILE2.$name                        = "TileTformatRxCRC";
TILE2.BOUNDARY.$name               = "BOUNDARY1";
TILE2.BOUNDARY.boundaryInput0      = "tileOutput";
