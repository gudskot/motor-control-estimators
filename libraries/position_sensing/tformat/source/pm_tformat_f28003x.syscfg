clb2.globalConfigCLB_IN0 = "CLB_GLOBAL_IN_MUX_CLB1_OUT21";
clb2.$name               = "PM_TFORMAT_RX_CRC";

TILE.generateSimulation = true;
TILE.reset_duration     = 5000;
